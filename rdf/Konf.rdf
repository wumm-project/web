  <schema:Event rdf:about="http://opendiscovery.org/rdf/Conferences/TDS_2025">
    <schema:about>TRIZ in IT, business and education; TRIZ and AI integration; Altshuller year</schema:about>
    <schema:audience>TRIZ experts, researchers, industry professionals</schema:audience>
    <schema:description>21st annual TRIZ Developers Summit titled 'TRIZ in Evolution', focusing on innovative applications of TRIZ in IT, business, education, and the opening of the International Year of G.S. Altshuller.</schema:description>
