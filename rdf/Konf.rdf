    <schema:url rdf:resource="https://triz-summit.ru/en/conference/tds-2025/"/>
  </schema:Event>
  <schema:Event rdf:about="http://opendiscovery.org/rdf/Conferences/TFC_2023">
    <schema:description>TFC 2023 focused on AI-driven invention and innovation, exploring the intersection of TRIZ with AI and systematic innovation methods. The conference included presentations, workshops, and case studies from academia and industry.</schema:description>
    <schema:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-14</schema:endDate>
    <schema:location>
      <schema:Place>
        <schema:address>
          <rdf:Description>
            <schema:addressCountry>DE</schema:addressCountry>
            <schema:addressLocality>Offenburg</schema:addressLocality>
          </rdf:Description>
        </schema:address>
        <schema:name>Offenburg University</schema:name>
      </schema:Place>
    </schema:location>
    <schema:name>23rd International TRIZ Future Conference (TFC‑2023)</schema:name>
    <schema:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-12</schema:startDate>
    <schema:url rdf:resource="https://tfc2023.etria.eu/"/>
    <schema:workPresented>
      <schema:CreativeWork>
        <schema:creator>Denis Cavallucci; Pavel Livotov; Stelian Brad</schema:creator>
        <schema:doi>https://doi.org/10.1007/978-3-031-42532-5</schema:doi>
        <schema:isbn>978-3-031-42532-5</schema:isbn>
        <schema:name>Towards AI-Aided Invention and Innovation: Proceedings of TFC 2023</schema:name>
        <schema:publisher>Springer Cham</schema:publisher>
        <schema:url rdf:resource="https://link.springer.com/book/10.1007/978-3-031-42532-5"/>
      </schema:CreativeWork>
    </schema:workPresented>
  </schema:Event>
