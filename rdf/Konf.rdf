        <schema:publisher>MATRIZ Official / Graz University of Technology</schema:publisher>
        <schema:url rdf:resource="http://www.triz-event.com/ITC-2023-Proceedings.pdf"/>
      </schema:CreativeWork>
    </schema:workPresented>
  </schema:Event>
  <schema:Event rdf:about="http://opendiscovery.org/rdf/Conferences/ITC_2025">
    <schema:about>TRIZ &amp; AI integration, innovation strategy, global collaboration</schema:about>
    <schema:description>ITC‑2025, hosted on Jeju Island, South Korea, is an international TRIZ conference organized by MATRIZ Official in collaboration with Korean TRIZ Association and partners, focusing on the integration of TRIZ with AI, intellectual property strategies, technology forecasting, and industry applications.</schema:description>
    <schema:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-27</schema:endDate>
    <schema:keywords>TRIZ, AI, innovation, problem solving, structured innovation</schema:keywords>
    <schema:location>
      <schema:Place>
        <schema:address>
          <rdf:Description>
            <schema:addressCountry>KR</schema:addressCountry>
            <schema:addressLocality>Jeju</schema:addressLocality>
          </rdf:Description>
        </schema:address>
        <schema:name>Jeju National University</schema:name>
      </schema:Place>
    </schema:location>
    <schema:name>International TRIZ Conference 2025 (ITC‑2025)</schema:name>
    <schema:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-25</schema:startDate>
    <schema:url rdf:resource="https://www.matriz-official.net/"/>
  </schema:Event>
  <schema:Event rdf:about="http://opendiscovery.org/rdf/Conferences/TDS_2023">
